def perdidas(utilidad,fondo):
    #Limpia Utilidad perdida
    df_utilidad = utilidad[utilidad["Movimiento"].isin(["Compra","Venta"])]
    df_utilidad = pd.merge(fondo, df_utilidad, on="Portafolio",how="inner")
    df_utilidad = df_utilidad[["ID","Ut/Pérd realizada"]]
    df_utilidad = df_utilidad.groupby("ID")["Ut/Pérd realizada"].sum().reset_index()
    
    return df_utilidad

def ventas(fondo,movs,solemi,vector):
    
    movs_ga = pd.merge(fondo,movs,on="Portafolio", how="inner")
    movs_ga = movs_ga[["ID","Movimiento","Emisora","Mon","Neto mon liq","Tasa"]]
    movs_ga = movs_ga.groupby(["ID","Movimiento", "Emisora", "Mon"], as_index=False).agg({"Tasa": "mean","Neto mon liq": "sum"})
    movs_ga = pd.merge(movs_ga,solemi,on="ID",how="left")
    movs_ga = pd.merge(movs_ga,vector,on="ID",how="left")
    


    #ORDENA PARA COMPRAS Y VENTAS
    df_ga = pd.merge(fondo,movs,on="Portafolio", how="inner")
    df_ga = df_ga[["Product","ID"]].drop_duplicates()
    df_ga = df_ga.groupby('ID')['Product'].apply(lambda x: ', '.join(x)).reset_index()
    df_ga = pd.merge(df_ga,movs_ga,on="ID",how="left")

    return df_ga


