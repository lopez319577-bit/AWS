#CREA FUNCIONES PARA CALCULAR RENDIMIENTOS


def return_years(df,año,metrica,tipo,date):
    
    result = []
    
    for portafolio in port:
        
        df_port = df[df["Fondo"] == portafolio]
        fecha_objetivo = df_port['Date'].max()
        # Calculamos la fecha que se requiera atrás
        fecha_ant = fecha_objetivo - pd.DateOffset(years= año)
        #Buscamos la fecha hábil anterior más próxima en el DataFrame
        fechas_validas = df_port[df_port['Date'] <= fecha_ant]
        fecha_ant_real = fechas_validas['Date'].max()
        #Calcular el rendimiento
        df_rend = df_port[(df_port['Date'] > fecha_ant_real) & (df_port['Date'] <= fecha_objetivo)]
        rendimiento = (df_rend['Valor'] + 1).prod() - 1
        rendimiento = ((1 + rendimiento) ** (1/año)) - 1 
        df_final = pd.DataFrame([{
             'Metrica': metrica,
             '%': rendimiento,
             'Portafolio': portafolio,
             'Type': tipo,
             'Date': date
        }])
        result.append(df_final)
        
        
    return pd.concat(result, ignore_index=True)


def return_ytdy_mtd(df,metrica,tipo,mes):
    
    result = []
    
    for portafolio in port:
        
        df_port = df[df["Fondo"] == portafolio]
        fecha_ytd = df_port['Date'].max()
        # Calculamos la fecha que se requiera atrás
        df_filtrado = df_port[df_port['Date'] >= pd.Timestamp(year=fecha_ytd.year, month=mes, day=1)]
        #Buscamos la fecha hábil anterior más próxima en el DataFrame
        #Calcular el rendimiento
        rendimiento = (df_filtrado['Valor'] + 1).prod() - 1
        df_final = pd.DataFrame([{
             'Metrica': metrica,
             '%': rendimiento,
             'Portafolio': portafolio,
             'Type': tipo,
             'Date': date
        }])
        result.append(df_final)
        
        
    return pd.concat(result, ignore_index=True)


