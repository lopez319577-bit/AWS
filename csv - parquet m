 ## Archivos destino
bucket_destino = 'inv-zone-smnylsbx'
destino_bucket = s3.Bucket(bucket_destino)
carpeta_destino = 'workspace/Data_Enginner/Mercado/xls/output_procesados/'

Ori_Arch = carpeta_origen
Des_Arch = carpeta_destino

for obj in origen_bucket.objects.filter(Prefix=Ori_Arch):
    old_source = { 'Bucket': bucket_origen,
                  'Key': obj.key}
    new_key = obj.key.replace(Ori_Arch, Des_Arch, 1)
    new_obj = destino_bucket.Object(new_key)
    new_obj.copy(old_source)

 
