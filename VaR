def var(column, port):
    df_acumulado = pd.DataFrame()

    for portafolio in port:
        prueb = matriz[matriz[column] == portafolio]

        if prueb.empty:
            print(f"Portafolio '{portafolio}' se omite.")
            continue

        oper = (
            prueb.groupby("HOLDING (PiP)", as_index=False)["Valor"]
                 .sum()
        )

        if oper.empty:
            print(f" Portafolio '{portafolio}' se omite.")
            continue

        df_ordenado = oper.sort_values(by='Valor')

        if len(df_ordenado) < 3:
            print(f" Portafolio '{portafolio}' se omite.")
            continue

        percentil = df_ordenado['Valor'].quantile(0.01)
        p = df_ordenado.iloc[2, 1]  # Puedes cambiar esto si quieres usar el percentil real
        fila = oper.loc[oper['Valor'] == p]
        fila = fila["HOLDING (PiP)"]
        cont = pd.merge(prueb, fila, on="HOLDING (PiP)", how="inner")
        df_acumulado = pd.concat([df_acumulado, cont], ignore_index=True)
        df_acumulado = df_acumulado[["ID", column, "Valor"]]

    return df_acumulado



