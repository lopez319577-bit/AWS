def matriz_rexpresada(matr, tc, vec, ponderador, mxn, date): 
    
    precio_cierre = vec[vec['Fecha'].dt.date == date]
    precio_cierre = precio_cierre.rename(columns={"Precio":"Precio cierre"})
    precio_cierre = precio_cierre[["ID","Precio cierre"]]

    #Fecha a analizar 
    fecha = matr[["HOLDING (PiP)"]]
    fecha = fecha.drop_duplicates()
    fecha = fecha.rename(columns={"HOLDING (PiP)":"Fecha"})

    #Tipo de cambio
    tc = tc[["Fecha","T cambio"]]
    tc = pd.merge(fecha, tc, on= "Fecha", how="inner")
    tc["Rendimiento"] = ((1/tc["T cambio"]) / (1/tc["T cambio"].shift(1))).fillna(1)
    tcr = tc[["Fecha", "Rendimiento"]]

    #Limpia matriz 
    df = matr[["ID", "HOLDING (PiP)", "Valor"]]
    df = df.drop_duplicates()
    df = df.rename(columns={"HOLDING (PiP)":"Fecha"})

    #Une matriz con calculos
    pr = pd.merge(df, ponderador, on="ID", how="inner") #REVISAR EL PONDERADOR ESTA MAL TIENE VALORES DUPLICADOS
    pr = pd.merge(pr,fecha, on="Fecha",how="inner")
    pr = pd.merge(pr,tcr,on="Fecha",how="left")
    pr = pd.merge(pr,precio_cierre,on="ID",how="left")
    pr["Precio cierre usd"] = pr["Precio cierre"] / mxn
    pr["Valor"] = (((((pr["Valor"] + pr["Precio cierre"]) / mxn) * pr["Rendimiento"]) - pr["Precio cierre usd"]) / pr["Base"])
    pr = pr[["ID", "Fecha", "Valor"]]
    pr = pr.rename(columns={"Fecha":"HOLDING (PiP)"})
    
    # Hacer el merge sin agregaciones, solo actualizando donde coincide ID y Fecha y conservando el Nombre
    matriz = pd.merge(matr, pr, on=["ID", "HOLDING (PiP)"], how="left", suffixes=('', '_nuevo'))
    #Actualizar valores solo donde haya coincidencia
    matriz['Valor'] = matriz['Valor_nuevo'].combine_first(matriz['Valor'])
    matriz.drop(columns=['Valor_nuevo'], inplace=True)

    return(matriz)

#Manda a llamar la función con la matriz reexpresada para USD
