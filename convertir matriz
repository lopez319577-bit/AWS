def matriz(ruta):
    with pd.ExcelFile(ruta) as xls: 
       df = pd.concat(pd.read_excel(xls, sheet_name=None, header= None), ignore_index=True, axis=1)
       titulos_o = df.iloc[0,:].astype("str").tolist() #Toma la fila cero y todas las columnas las guarda en esta variable
       df.columns = titulos_o # Le da el nombre a las columnas que guardo en la varibale titulos
       df = df.iloc[2:1002,:] #Toma de la fila 0 en adelante y todas las columnas (practicamente elimina toda la fila 0)
       df = df.loc[:, ~df.columns.duplicated()] #Selecciona sólo las columnas que no están duplicadas
       df["HOLDING (PiP)"] = pd.to_datetime(df["HOLDING (PiP)"], errors= "coerce") #Convierte la columna a tipo date
       df[df.columns[1:]] = df[df.columns[1:]].astype(float) #Convierte la columna a tipo float

    return df

