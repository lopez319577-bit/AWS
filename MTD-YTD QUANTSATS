#CREA FUNCIONES PARA CALCULAR RENDIMIENTOS

#Define función para el calculo de MTD y YTD
def rend (port, date): #Función MTD - EOY para todos los fondos
    result = []
    df_f = fondo
    df_b = bench
    mes_actual = mes_act
    for portafolio in port:
        df_fondo = df_f[df_f["Fondo"] == portafolio]
        df_benchmark = df_b[df_b["Fondo"] == portafolio]
        frame = [("Fondo", df_fondo), ("Benchmark", df_benchmark)]
        for dataframe_name, df in frame:
            
            df = df[["Date", "Valor"]].set_index("Date")
            df = qs.stats.monthly_returns(df).iloc[-1]
            df = pd.DataFrame(df)
            df = (df).reset_index()
            df = df.loc[(df["index"] == mes_actual) | (df["index"] == "EOY")]
            df['index'] = df['index'].replace({mes_actual: 'MTD', 'EOY': 'YTD'})
            df.columns = ["Metrica","%"] 
            df["Portafolio"] = portafolio
            df["Type"] = dataframe_name
            df["Date"] = date
            result.append(df)
    
    final_result = pd.concat(result) 
    return final_result



def return_years(df,año,metrica,tipo,date):
    
    result = []
    
    for portafolio in port:
        
        df_port = df[df["Fondo"] == portafolio]
        fecha_objetivo = df_port['Date'].max()
        # Calculamos la fecha que se requiera atrás
        fecha_ant = fecha_objetivo - pd.DateOffset(years= año)
        #Buscamos la fecha hábil anterior más próxima en el DataFrame
        fechas_validas = df_port[df_port['Date'] <= fecha_ant]
        fecha_ant_real = fechas_validas['Date'].max()
        #Calcular el rendimiento
        df_rend = df_port[(df_port['Date'] > fecha_ant_real) & (df_port['Date'] <= fecha_objetivo)]
        rendimiento = (df_rend['Valor'] + 1).prod() - 1
        rendimiento = ((1 + rendimiento) ** (1/año)) - 1 
        df_final = pd.DataFrame([{
             'Metrica': metrica,
             '%': rendimiento,
             'Portafolio': portafolio,
             'Type': tipo,
             'Date': date
        }])
        result.append(df_final)
        
        
    return pd.concat(result, ignore_index=True)


